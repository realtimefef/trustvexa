{
  "name": "@trustvexa/worker",
  "version": "0.0.0",
  "private": true,
  "description": "TrustVexa Node + TypeScript worker service (blockchain watchers, BullMQ jobs, SLA timers)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@trustvexa/api": "workspace:*",
    "@trustvexa/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^8.0.11",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
