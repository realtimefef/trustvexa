NODE_ENV=development
# The web app runs on 3000; the API runs on 4000. Do NOT set this to 4000 or
# `next dev` will collide with the API server.
PORT=3000

DATABASE_URL=postgres://postgres:anypwd@127.0.0.1:5434/trustvexa
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=Un6QZzldqfi12KOc4YuEh5FB7oe0sDSpj83NkGRVXwCtyvIJ
JWT_REFRESH_SECRET=diIkm5s2fhDx0aGPRzpL6Z7AnOQTNMg1eCKBlSJ4YwvjXFyc
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

TRUSTVEXA_MASTER_KEK=NJuYGrkgRl00iKGu3ECLObcbHHFRjJQpj612EQ7hiBM=
AUTH_LOOKUP_HASH_KEY=a710q/eg5OJJnJyDDuadPD9hM74ODyP+

TRUST_PROXY_HOPS=1

WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Browser-exposed API origin. MUST be prefixed with NEXT_PUBLIC_ so it is
# available to client-side code (the API client in src/lib/api/client.ts).
# Without this, browser fetches default to the same origin (the Next.js web
# server) and every /api/v1/* call returns 404 (e.g. "Registration failed").
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@trustvexa.com

FX_PRIMARY_URL=https://api.coingecko.com/api/v3
FX_PRIMARY_API_KEY=
FX_BACKUP_URL=
FX_BACKUP_API_KEY=
FILE_LINK_SECRET=development_file_link_secret_key_123456
