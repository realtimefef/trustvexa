/**
 * Next.js middleware for server-side auth with rotating refresh tokens.
 *
 * On every request to a protected route this middleware:
 *  1. Reads the `tv_refresh` httpOnly cookie from the incoming request.
 *  2. Calls the API /auth/refresh endpoint server-to-server.
 *  3. Forwards the new rotated `tv_refresh` cookie to the browser in the response,
 *     so the browser always has the latest token.
 *  4. Injects `x-auth-payload` into the downstream request headers so
 *     Server Components can read auth data without calling the API a second time
 *     (which would try to reuse an already-consumed refresh token).
 *
 * This solves the "token already used" error that occurred when the server-side
 * guard in the layout called /auth/refresh and rotated the token but the browser
 * was never updated with the new cookie.
 */

import { NextRequest, NextResponse } from 'next/server';

const API_ORIGIN =
  process.env.API_BASE_URL ?? process.env.NEXT_PUBLIC_API_BASE_URL ?? 'http://localhost:4000';

const REFRESH_COOKIE = 'tv_refresh';

async function refreshSession(
  req: NextRequest,
): Promise<{ response: NextResponse; authPayload: string } | null> {
  const refreshToken = req.cookies.get(REFRESH_COOKIE)?.value;
  if (!refreshToken) return null;

  let apiRes: Response;
  try {
    apiRes = await fetch(`${API_ORIGIN}/api/v1/auth/refresh`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Cookie: `${REFRESH_COOKIE}=${refreshToken}`,
      },
      body: JSON.stringify({}),
    });
  } catch {
    return null;
  }

  if (!apiRes.ok) return null;

  const data = (await apiRes.json()) as {
    user: { id: string; username: string; role: string };
    access_token: string;
    access_expires_at: string;
  };

  const authPayload = Buffer.from(
    JSON.stringify({
      user: data.user,
      access_token: data.access_token,
      access_expires_at: data.access_expires_at,
    }),
  ).toString('base64');

  // Build modified request headers — Next.js forwards these to Server Components.
  const requestHeaders = new Headers(req.headers);
  requestHeaders.set('x-auth-payload', authPayload);

  // Build the response with the updated request headers.
  const response = NextResponse.next({
    request: { headers: requestHeaders },
  });

  // Parse the rotated refresh cookie from the API response and set it on the
  // browser response so subsequent navigations carry the new token.
  const setCookieHeader = apiRes.headers.get('set-cookie');
  if (setCookieHeader) {
    const match = setCookieHeader.match(new RegExp(`${REFRESH_COOKIE}=([^;]+)`));
    if (match?.[1]) {
      const expiresMatch = setCookieHeader.match(/Expires=([^;]+)/i);
      const maxAgeMatch = setCookieHeader.match(/Max-Age=(\d+)/i);
      let expires: Date | undefined;
      if (expiresMatch?.[1]) {
        expires = new Date(expiresMatch[1]);
      }
      const maxAge = maxAgeMatch?.[1] ? parseInt(maxAgeMatch[1], 10) : undefined;

      response.cookies.set(REFRESH_COOKIE, match[1], {
        httpOnly: true,
        secure: process.env.NODE_ENV === 'production',
        sameSite: 'strict',
        path: '/',
        ...(expires ? { expires } : {}),
        ...(maxAge !== undefined ? { maxAge } : {}),
      });
    }
  }

  return { response, authPayload };
}

export async function middleware(req: NextRequest) {
  const result = await refreshSession(req);

  if (!result) {
    // No refresh token or refresh failed → redirect to login.
    const loginUrl = req.nextUrl.clone();
    loginUrl.pathname = '/login';
    loginUrl.search = '';
    return NextResponse.redirect(loginUrl);
  }

  return result.response;
}

export const config = {
  matcher: [
    '/dashboard/:path*',
    '/deals/:path*',
    '/wallet/:path*',
    '/transactions/:path*',
    '/messages/:path*',
    '/disputes/:path*',
    '/documents/:path*',
    '/settings/:path*',
    '/notifications/:path*',
    '/profile/:path*',
    '/referrals/:path*',
    '/reviews/:path*',
    '/templates/:path*',
    '/support/:path*',
    '/calculator/:path*',
    '/announcements/:path*',
  ],
};
