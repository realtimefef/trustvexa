# ─────────────────────────────────────────────────────────────────────────────
# TrustVexa — Environment Variables Reference
# Copy this file to .env (never commit .env!)
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=https://api.trustvexa.com
CORS_ORIGINS=https://trustvexa.com,https://www.trustvexa.com
WEB_APP_URL=https://trustvexa.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/trustvexa_prod
DATABASE_URL_TEST=postgres://user:password@localhost:5432/trustvexa_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=hex-encoded-32-byte-aes-key-here
FILE_LINK_SECRET=change-me-to-a-random-signing-secret

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@trustvexa.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@trustvexa.com
ADMIN_EMAIL=admin@trustvexa.com

# ── Object Storage (S3-compatible) ────────────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=trustvexa-docs
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@trustvexa.com

# ── Blockchain ────────────────────────────────────────────────────────────────
MAINNET_ENABLED=false
TRONWEB_API_KEY=your-tronweb-api-key

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=3002
WORKER_HEARTBEAT_MS=30000
SLA_SWEEP_INTERVAL_MS=60000
DEPOSIT_WATCH_INTERVAL_MS=30000

# ── FX Rate Refresh ───────────────────────────────────────────────────────────
FX_MAX_AGE_SECONDS=120
FX_TOLERANCE_PCT=2
